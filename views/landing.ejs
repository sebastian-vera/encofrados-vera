          <div><div class="hs-n">+19</div><div class="hs-l">Años en el rubro</div></div>
          <div><div class="hs-n">4</div><div class="hs-l">Bases operativas</div></div>
        </div>
      </div>

      <div class="hr ai d2">
        <div class="hv">
          <div class="hcard">
            <div class="hcb">Disponible</div>
            <div class="hci">🧱</div>
            <div class="hct">Moldaje de Muro</div>
            <div class="hcs">Modular de acero y liviano manoportable</div>
            <div class="hcl">
              <span class="hcc">Paneles hasta 2,70 m</span>
              <span class="hcc">Presión 60–80 kN/m²</span>
              <span class="hcc">Esquinas y compensaciones</span>
            </div>
          </div>
          <div class="hcard">
            <div class="hcb">Disponible</div>
            <div class="hci">🏗️</div>
            <div class="hct">Moldaje de Losa</div>
            <div class="hcs">Vigas H20, cabezales y puntales regulables</div>
          </div>
