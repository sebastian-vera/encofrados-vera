<!-- ═══════════ HERO ═══════════ -->
<section id="hero">
  <div class="hero-grid"></div>
  <div class="wrap">
    <div class="hc">

      <div class="hero-l">
        <span class="eyebrow ai">Arriendo y venta de moldajes · Chile</span>
        <div class="hero-code ai d1">SISTEMA DE ENCOFRADO / EV-CL</div>
        <h1 class="ai d1">
          El molde<br/>
          <span class="ln2">correcto</span><br/>
          para cada vaciado
        </h1>
        <p class="ai d2">
          Moldajes y encofrados para muros, losas, columnas, fundaciones y obra
          civil — compatibles con los principales sistemas del mercado chileno,
          con asesoría de despiece en terreno y despacho a todo el país.
        </p>
        <div class="ha ai d3">
          <a href="#contacto" class="btn btn-primary">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Solicitar cotización
          </a>
          <a href="#productos" class="btn btn-ghost">Ver catálogo</a>
        </div>
        <div class="hstats ai d4">
          <div class="hstat"><div class="hstat-n">16</div><div class="hstat-l">Sistemas</div></div>
          <div class="hstat"><div class="hstat-n">+19</div><div class="hstat-l">Años en rubro</div></div>
          <div class="hstat"><div class="hstat-n">4</div><div class="hstat-l">Bases operativas</div></div>
        </div>
      </div>

      <!-- SIGNATURE: panel de moldaje con anclajes y cotas -->
      <div class="hpanel ai d2" aria-hidden="true">
        <svg viewBox="0 0 420 486" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Panel de moldaje">
          <defs>
            <linearGradient id="ph" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#D2A05A"/>
              <stop offset="0.5" stop-color="#C58A3D"/>
              <stop offset="1" stop-color="#AE7930"/>
            </linearGradient>
          </defs>

          <!-- cota superior -->
          <g font-family="'IBM Plex Mono',monospace" font-size="12" fill="#52565E">
            <line x1="46" y1="24" x2="374" y2="24" stroke="#8A8D91" stroke-width="1"/>
            <line x1="46" y1="19" x2="46" y2="29" stroke="#8A8D91" stroke-width="1"/>
            <line x1="374" y1="19" x2="374" y2="29" stroke="#8A8D91" stroke-width="1"/>
            <rect x="185" y="14" width="50" height="18" fill="#E4E1DA"/>
            <text x="210" y="27" text-anchor="middle">0,90 m</text>
          </g>

          <!-- marco de acero -->
          <rect x="46" y="40" width="328" height="404" rx="4" fill="#22252A"/>
          <!-- cara fenólica -->
          <rect x="58" y="52" width="304" height="380" rx="2" fill="url(#ph)"/>

          <!-- perfiles del marco (costillas) -->
          <g stroke="#96682A" stroke-width="2" opacity="0.55">
            <line x1="160" y1="52" x2="160" y2="432"/>
            <line x1="260" y1="52" x2="260" y2="432"/>
            <line x1="58" y1="147" x2="362" y2="147"/>
            <line x1="58" y1="242" x2="362" y2="242"/>
            <line x1="58" y1="337" x2="362" y2="337"/>
          </g>

          <!-- perforaciones de anclaje (tie-holes) -->
          <g>
            <!-- fila util donde cruzan costillas -->
            <g fill="#1A1C20">
              <circle cx="110" cy="147" r="7"/><circle cx="210" cy="147" r="7"/><circle cx="310" cy="147" r="7"/>
              <circle cx="110" cy="242" r="7"/><circle cx="210" cy="242" r="7"/><circle cx="310" cy="242" r="7"/>
              <circle cx="110" cy="337" r="7"/><circle cx="210" cy="337" r="7"/><circle cx="310" cy="337" r="7"/>
            </g>
            <g fill="none" stroke="#DCA85E" stroke-width="1.5">
              <circle cx="110" cy="147" r="10"/><circle cx="210" cy="147" r="10"/><circle cx="310" cy="147" r="10"/>
              <circle cx="110" cy="242" r="10"/><circle cx="210" cy="242" r="10"/><circle cx="310" cy="242" r="10"/>
              <circle cx="110" cy="337" r="10"/><circle cx="210" cy="337" r="10"/><circle cx="310" cy="337" r="10"/>
            </g>
          </g>

          <!-- marca de tiza roja (precisión) -->
          <g stroke="#EE0117" stroke-width="2.4" fill="none" stroke-linecap="round">
            <path d="M74 402 l16 14 l26 -30"/>
          </g>

          <!-- cota lateral: presión -->
          <g font-family="'IBM Plex Mono',monospace" font-size="12" fill="#52565E">
            <line x1="392" y1="52" x2="392" y2="432" stroke="#8A8D91" stroke-width="1"/>
            <line x1="387" y1="52" x2="397" y2="52" stroke="#8A8D91" stroke-width="1"/>
            <line x1="387" y1="432" x2="397" y2="432" stroke="#8A8D91" stroke-width="1"/>
            <text x="392" y="248" text-anchor="middle" transform="rotate(90 392 244)">60–80 kN/m²</text>
          </g>

          <!-- etiqueta de referencia -->
          <g font-family="'IBM Plex Mono',monospace">
            <text x="58" y="470" font-size="12.5" font-weight="600" fill="#1A1C20">MUR·01</text>
            <text x="362" y="470" font-size="11" fill="#8A8D91" text-anchor="end">PLACA FENÓLICA · 15 mm</text>
          </g>
        </svg>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════ PRODUCTOS ═══════════ -->
