<!-- ═══════════════════════════════════════════
     PRODUCTOS
════════════════════════════════════════════ -->
<section id="productos">
  <div class="wrap">
    <div class="sh">
      <span class="tag" data-r>Nuestro catálogo</span>
      <h2 data-r class="t1">Encofrados para cada <span class="hl">elemento de hormigón</span></h2>
      <p data-r class="t2">Equipos revisados, con piezas completas y respaldo técnico. Arriendo, venta y asesoría de despiece incluidos.</p>
    </div>
    <div class="fg">

      <!-- Moldaje de muro modular -->
      <div class="fc" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <rect x="3" y="4" width="18" height="16" rx="1"/>
              <path stroke-linecap="round" d="M3 9.5h18M3 15h18M9 4v5.5M15 9.5V15M9 15v5"/>
            </svg>
          </div>
          <div class="fn">01</div>
        </div>
        <div class="ftitle">Moldaje de Muro Modular</div>
        <div class="fd">Paneles de marco de acero con placa fenólica, para muros de hormigón armado en altura. Alta presión admisible y mínimo número de anclajes por m².</div>
        <div class="fs">
          <span class="fsp">Paneles 0,30 a 2,70 m</span>
          <span class="fsp">60–80 kN/m²</span>
          <span class="fsp">Esquinas interior/exterior</span>
          <span class="fsp">Compensaciones</span>
        </div>
      </div>

      <!-- Moldaje de muro liviano -->
      <div class="fc t1" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <rect x="4" y="3" width="7" height="18" rx="1"/>
              <rect x="13" y="3" width="7" height="18" rx="1"/>
              <path stroke-linecap="round" d="M7.5 11h0M16.5 11h0"/>
            </svg>
          </div>
          <div class="fn">02</div>
        </div>
        <div class="ftitle">Moldaje Liviano / Manoportable</div>
        <div class="fd">Sistemas de aluminio y acero liviano para obras sin grúa: viviendas, muros de contención bajos, cámaras y trabajos de terminación.</div>
        <div class="fs">
          <span class="fsp">Sin grúa</span>
          <span class="fsp">Desde 20 kg/panel</span>
          <span class="fsp">Montaje rápido</span>
        </div>
      </div>

      <!-- Moldaje de losa -->
      <div class="fc t2" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M2 7h20M2 10h20"/>
              <path stroke-linecap="round" d="M6 10v11M12 10v11M18 10v11M4 21h4M10 21h4M16 21h4"/>
            </svg>
          </div>
          <div class="fn">03</div>
        </div>
        <div class="ftitle">Moldaje de Losa</div>
        <div class="fd">Sistema de vigas de madera H20, cabezales de descimbre y puntales regulables. Permite liberar el moldaje manteniendo el apuntalamiento de seguridad.</div>
        <div class="fs">
          <span class="fsp">Vigas H20 · 1,90 a 5,90 m</span>
          <span class="fsp">Cabezal de descimbre</span>
          <span class="fsp">Tableros 18 y 21 mm</span>
        </div>
      </div>

      <!-- Mesas de encofrado -->
      <div class="fc" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M2 8h20v2H2z"/>
              <path stroke-linecap="round" d="M5 10v9M19 10v9M5 19h3M16 19h3M8 14h8"/>
            </svg>
          </div>
          <div class="fn">04</div>
        </div>
        <div class="ftitle">Mesas de Encofrado</div>
        <div class="fd">Mesas prearmadas y mesas voladoras para losas de gran superficie. Ciclos de hormigonado más rápidos y menos horas hombre por m².</div>
        <div class="fs">
          <span class="fsp">Prearmadas en obra</span>
          <span class="fsp">Traslado con grúa</span>
          <span class="fsp">Alto rendimiento</span>
        </div>
      </div>

      <!-- Columnas -->
      <div class="fc t1" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <rect x="8" y="3" width="8" height="18" rx="1"/>
              <path stroke-linecap="round" d="M5 7h14M5 12h14M5 17h14"/>
            </svg>
          </div>
          <div class="fn">05</div>
        </div>
        <div class="ftitle">Moldaje de Columnas y Pilares</div>
        <div class="fd">Moldajes de sección cuadrada, rectangular y circular, con regulación por escalones y acabado visto. Incluye plataforma de hormigonado y accesos.</div>
        <div class="fs">
          <span class="fsp">Cuadrada / rectangular</span>
          <span class="fsp">Circular Ø 25 a 120 cm</span>
          <span class="fsp">Hormigón visto</span>
        </div>
      </div>

      <!-- Fundaciones -->
      <div class="fc t2" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M2 14h20M4 14V9h16v5"/>
              <path stroke-linecap="round" d="M2 18h20M7 14v4M17 14v4"/>
            </svg>
          </div>
          <div class="fn">06</div>
        </div>
        <div class="ftitle">Fundaciones, Poyos y Radieres</div>
        <div class="fd">Encofrado de zapatas, dados, vigas de fundación y cámaras. Sistemas de bajo peso, resistentes a terreno húmedo y fáciles de alinear.</div>
        <div class="fs">
          <span class="fsp">Zapatas y dados</span>
          <span class="fsp">Vigas de fundación</span>
          <span class="fsp">Cámaras y cámaras técnicas</span>
        </div>
      </div>

      <!-- Trepante -->
      <div class="fc" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M12 21V3M8 6l4-3 4 3"/>
              <rect x="4" y="10" width="16" height="4" rx="1"/>
              <path stroke-linecap="round" d="M4 18h16"/>
            </svg>
          </div>
          <div class="fn">07</div>
        </div>
        <div class="ftitle">Sistemas Trepantes</div>
        <div class="fd">Consolas trepantes y autotrepantes para núcleos, pilas de puente y muros de gran altura. Plataformas de trabajo integradas y protección perimetral.</div>
        <div class="fs">
          <span class="fsp">Núcleos de ascensor</span>
          <span class="fsp">Pilas de puente</span>
          <span class="fsp">Plataforma integrada</span>
        </div>
      </div>

      <!-- Puntales -->
      <div class="fc t1" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M12 3v18M8 3h8M8 21h8"/>
              <circle cx="12" cy="10" r="2.2"/>
            </svg>
          </div>
          <div class="fn">08</div>
        </div>
        <div class="ftitle">Puntales y Torres de Carga</div>
        <div class="fd">Puntales metálicos regulables (alza primas) y torres de carga para grandes alturas y cargas puntuales elevadas, con husillos y bases regulables.</div>
        <div class="fs">
          <span class="fsp">Puntales 1,8 a 5,5 m</span>
          <span class="fsp">Torres de carga</span>
          <span class="fsp">Husillos y bases</span>
        </div>
      </div>

      <!-- Andamios -->
      <div class="fc t2" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M4 3v18M12 3v18M20 3v18M4 8h16M4 14h16M4 20h16"/>
            </svg>
          </div>
          <div class="fn">09</div>
        </div>
        <div class="ftitle">Andamios Multidireccional y Fachada</div>
        <div class="fd">Andamio modular de roseta y andamio de marco para fachada, con plataformas de acero, rodapiés, barandas y accesos certificados.</div>
        <div class="fs">
          <span class="fsp">Multidireccional</span>
          <span class="fsp">Fachada / marco</span>
          <span class="fsp">Torres móviles</span>
        </div>
      </div>

      <!-- Plataformas y seguridad -->
      <div class="fc" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <path stroke-linecap="round" d="M3 12h18M3 12v7M21 12v7"/>
              <path stroke-linecap="round" d="M6 12V6h12v6M6 16h12"/>
            </svg>
          </div>
          <div class="fn">10</div>
        </div>
        <div class="ftitle">Plataformas y Consolas de Seguridad</div>
        <div class="fd">Consolas de hormigonado, plataformas de trabajo en borde de losa y protección perimetral. Cumplimiento del estándar de trabajo en altura.</div>
        <div class="fs">
          <span class="fsp">Consolas de hormigonado</span>
          <span class="fsp">Protección perimetral</span>
          <span class="fsp">Redes y barandas</span>
        </div>
      </div>

      <!-- Vigas y tableros -->
      <div class="fc t1" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <rect x="2" y="5" width="20" height="4" rx="1"/>
              <rect x="2" y="14" width="20" height="5" rx="1"/>
              <path stroke-linecap="round" d="M6 9v5M18 9v5"/>
            </svg>
          </div>
          <div class="fn">11</div>
        </div>
        <div class="ftitle">Vigas H20 y Tableros Fenólicos</div>
        <div class="fd">Vigas de madera laminada H20 y tableros fenólicos / terciado estructural de 18 y 21 mm, para moldajes a medida y reposición de placa.</div>
        <div class="fs">
          <span class="fsp">Vigas H20</span>
          <span class="fsp">Tableros 18 / 21 mm</span>
          <span class="fsp">Corte a medida</span>
        </div>
      </div>

      <!-- Accesorios -->
      <div class="fc fc-accent t2" data-r>
        <div class="fct">
          <div class="fi">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#ee0117" stroke-width="1.6">
              <circle cx="12" cy="12" r="3"/>
              <path stroke-linecap="round" d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>
            </svg>
          </div>
          <div class="fn">12</div>
        </div>
        <div class="ftitle">Accesorios, Fijaciones y Asesoría</div>
        <div class="fd">Barras de anclaje, tuercas de placa, conos, alineadores, escuadras, desmoldante y todo el consumible. Además elaboramos el plano de despiece de tu obra.</div>
        <div class="fs">
          <span class="fsp">Barras y anclajes</span>
          <span class="fsp">Alineadores y escuadras</span>
          <span class="fsp">Desmoldante</span>
          <span class="fsp">Plano de despiece</span>
        </div>
      </div>

    </div>
  </div>
</section>

