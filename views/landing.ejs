      <h2 data-r class="t1">Nuestros sistemas <span class="hl">en obra</span></h2>
      <p data-r class="t2">Soluciones montadas en edificación en altura, obra civil e industria.</p>
    </div>
    <div class="gal">

      <div class="gal-card" data-r>
        <img src="/images/productos/moldaje-muro-modular.jpg" alt="Moldaje de muro modular de acero" loading="lazy" width="1200" height="800"/>
        <div class="gal-overlay">
          <span class="gal-tag">Moldaje de Muro</span>
          <p>Panel modular con anclaje pasante</p>
        </div>
      </div>

      <div class="gal-card t1" data-r>
        <img src="/images/productos/moldaje-losa.jpg" alt="Moldaje de losa con vigas H20 y tablero fenólico" loading="lazy" width="1200" height="800"/>
        <div class="gal-overlay">
          <span class="gal-tag">Moldaje de Losa</span>
          <p>Vigas H20 + tablero fenólico</p>
        </div>
      </div>

      <div class="gal-card t2" data-r>
        <img src="/images/productos/puntales-torres.jpg" alt="Puntales metálicos regulables apuntalando una losa" loading="lazy" width="1200" height="800"/>
        <div class="gal-overlay">
          <span class="gal-tag">Puntales</span>
          <p>Apuntalamiento y descimbre seguro</p>
        </div>
