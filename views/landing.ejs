<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>

  <!-- ── SEO BÁSICO ── -->
  <title><%= title %></title>
  <meta name="description" content="<%= description %>"/>
  <meta name="keywords" content="arriendo encofrados Chile, arriendo moldajes, venta moldajes, moldaje de muro, moldaje de losa, encofrado columnas, puntales, andamios, vigas H20, tableros fenólicos, Encofrados Vera"/>
  <meta name="author" content="Encofrados Vera"/>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"/>
  <link rel="canonical" href="https://encofradosvera.cl/"/>

  <!-- ── OPEN GRAPH (Facebook, LinkedIn, WhatsApp) ── -->
  <meta property="og:type"        content="website"/>
  <meta property="og:url"         content="https://encofradosvera.cl/"/>
  <meta property="og:title"       content="<%= title %>"/>
  <meta property="og:description" content="<%= description %>"/>
  <meta property="og:image"       content="https://encofradosvera.cl/images/og-image.jpg"/>
  <meta property="og:image:width"  content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:locale"      content="es_CL"/>
  <meta property="og:site_name"   content="Encofrados Vera"/>

  <!-- ── TWITTER CARD ── -->
  <meta name="twitter:card"        content="summary_large_image"/>
  <meta name="twitter:title"       content="<%= title %>"/>
  <meta name="twitter:description" content="<%= description %>"/>
  <meta name="twitter:image"       content="https://encofradosvera.cl/images/og-image.jpg"/>

  <!-- ── SCHEMA.ORG — LocalBusiness ── -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Encofrados Vera",
    "description": "Arriendo y venta de moldajes y encofrados para muros, losas, columnas, fundaciones y obra civil en Chile. Asesoría técnica en terreno y cobertura nacional.",
    "url": "https://encofradosvera.cl",
    "logo": "https://encofradosvera.cl/images/logo-vera.png",
    "image": "https://encofradosvera.cl/images/og-image.jpg",
    "telephone": "+56974764806",
    "email": "cristian.vera@encofradosvera.cl",
    "areaServed": "CL",
    "currenciesAccepted": "CLP",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Av. Ossa 235, Of. 1265",
      "addressLocality": "La Reina",
      "addressRegion": "Región Metropolitana",
      "addressCountry": "CL"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -33.4489,
      "longitude": -70.6693
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:30",
      "closes": "18:00"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Arriendo y Venta de Moldajes y Encofrados",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Arriendo de moldaje de muro modular" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Arriendo de moldaje de losa con vigas H20 y puntales" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Arriendo de moldaje de columnas y pilares" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Arriendo de sistemas trepantes" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Arriendo de andamio multidireccional y de fachada" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Asesoría técnica y plano de despiece de moldaje" }}
      ]
    }
  }
  </script>

  <!-- ── FAVICONS ── -->
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.png"/>
  <link rel="apple-touch-icon"                    href="/images/favicon.png"/>
  <meta name="theme-color" content="#ee0117"/>

  <!-- ── PERFORMANCE ── -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/></noscript>
  <link rel="stylesheet" href="/css/landing.css"/>

  <!-- ── CLOUDFLARE TURNSTILE ── -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <!-- ── GOOGLE ANALYTICS 4 ── -->
  <% if (gaId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', '<%= gaId %>');
  </script>
  <% } %>
</head>
<body>

